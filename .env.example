# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Base URL of the backend API (no trailing slash). Local dev talks to the
# backend directly (both on localhost, so cookies are same-site already).
# Production (see .env.production) must instead use the relative "/api/v1"
# so the browser stays same-origin with this app's own domain — see
# vercel.json and lib/api.ts.
VITE_API_URL=http://localhost:4000/api/v1

# Base URL of the public Next.js frontend (no trailing slash) — used only
# to build "Preview" links to /blog/preview/:id.
VITE_SITE_URL=http://localhost:3000
